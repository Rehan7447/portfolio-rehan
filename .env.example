# ─────────────────────────────────────────────────────────────
# Contact form email delivery (Resend — https://resend.com)
# Create a free account, verify a sending domain, grab an API key.
# Without these set, the contact API still returns success in dev
# and logs the submission to the server console (no email sent).
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=

# The verified "from" address Resend will send through.
# e.g. "Portfolio <hello@yourdomain.com>"  (must be on a verified domain)
CONTACT_FROM_EMAIL=

# Where contact submissions get delivered (your inbox).
CONTACT_TO_EMAIL=rehan@sobrietyhub.com

# Public site URL (used for canonical, sitemap, OG). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://rehanashraf.dev
