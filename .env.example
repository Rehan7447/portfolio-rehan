# ─────────────────────────────────────────────────────────────
# Email delivery (SMTP)
#
# Used by both intake routes:
#   POST /api/contact     the human contact form
#   POST /api/agent/lead  the agent API (see /for-ai-agents)
#
# Without these set, both routes still succeed and log the submission
# to the server console instead of sending — the agent API reports
# "delivery": "logged" rather than "sent" so the caller can tell.
#
# Gmail: enable 2FA, then create an App Password
# (https://myaccount.google.com/apppasswords) and use it as SMTP_PASSWORD —
# your normal account password will not work.
# ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# The "From" address. Most providers require this to match SMTP_USER.
# Defaults to SMTP_USER if left blank. e.g. "Portfolio <you@gmail.com>"
CONTACT_FROM_EMAIL=

# Where contact submissions get delivered (your inbox).
CONTACT_TO_EMAIL=m.rd7447@gmail.com

# Public site URL (used for canonical, sitemap, OG). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://rehanashraf.dev
